// 수집 결과(public/)를 Cloudflare Workers 정적 자산으로 게시한다. 코드(main) 없이 파일만 서빙한다.
// Cloudflare Pages 는 Workers 로 통합되는 중이라(2026) 새 프로젝트는 Workers 정적 자산으로 만든다. _headers 는 그대로 적용된다.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rfg-data",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public" },
  "workers_dev": true,
  "preview_urls": false
}
